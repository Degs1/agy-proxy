{
  "name": "antigravity-gateway",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:init": "tsx --env-file=.env src/lib/db/init.ts",
    "db:verify": "tsx --env-file=.env src/lib/db/verify.ts",
    "db:deploy": "tsx --env-file=.env src/lib/db/init.ts && tsx --env-file=.env src/lib/db/verify.ts",
    "auth:bootstrap": "tsx --env-file=.env scripts/bootstrap-admin.ts",
    "test": "vitest run && tsx --test tests/validation/body-reader.test.ts tests/validation/chat-completion.test.ts tests/validation/fingerprint.test.ts tests/validation/pipeline.test.ts",
    "test:watch": "vitest",
    "worker:recovery": "tsx src/workers/recovery-worker.ts",
    "auth:antigravity": "tsx --env-file=.env scripts/connect-antigravity.ts",
    "test:chat": "tsx scripts/test-chat-completion.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "autoprefixer": "^10.6.2",
    "lucide-react": "^1.67.0",
    "mongodb": "^6.12.0",
    "next": "^15.1.4",
    "postcss": "^8.5.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^29.1.1",
    "mongodb-memory-server": "^10.1.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
